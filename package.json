{
  "name": "forgeline",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "vendor": "node scripts/vendor-runtimes.mjs",
    "predev": "npm run content && npm run vendor",
    "dev": "vite",
    "prebuild": "npm run content && npm run vendor",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "mermaid": "^11.17.2",
    "pyodide": "^314.0.7",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sql-formatter": "^15.9.0",
    "sql.js": "^1.15.0",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "description": "Forgeline: a static software engineering study hub with guides, interview prep, flashcards, mock interviews and a skill map."
}
